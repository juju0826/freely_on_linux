#!/usr/bin/env bash
# cloudbak
#
# Tailored backup script for this Nextcloud + Collabora host.
#
# What it backs up:
#   - /etc/nginx/sites-available + sites-enabled
#   - /var/www/nextcloud/config/config.php
#   - Nextcloud database: nextcloud
#   - Collabora container metadata + coolwsd config + env + nginx myoffice config
#   - Selected operator scripts under /home/libengju
#   - Nextcloud data directory snapshot: /var/www/nextcloud-data/ncdata
#
# Optional:
#   - If SAVE_COLLABORA_IMAGE=1 is set in the environment,
#     also save the Collabora image as tar.gz
#
# Backup target:
#   /var/www/nextcloud-data/cloudbak
#
# Notes:
#   - This script auto-generates a timestamped snapshot directory.
#   - It also refreshes a "latest" symlink.
#   - It uses rsync --link-dest to make incremental snapshots when possible.
#   - It re-execs itself with sudo when needed, so you can simply type:
#         cloudbak
#
# Caveat:
#   Because /var/www/nextcloud-data is already on the 1TB HDD, backing up
#   ncdata into /var/www/nextcloud-data/cloudbak protects you from mistakes,
#   bad updates, and accidental deletion, but NOT from total failure of that HDD.
#   For true disaster recovery, keep one more copy on a different disk / machine.

set -Eeuo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

BACKUP_ROOT="/var/www/nextcloud-data/cloudbak"
NC_WEB_ROOT="/var/www/nextcloud"
NC_CONFIG="/var/www/nextcloud/config/config.php"
NC_DATA_DIR="/var/www/nextcloud-data/ncdata"
NC_LOG_ROOT="/var/www/nextcloud-data"
DB_NAME="nextcloud"
DB_USER="ncuser"
COLLABORA_CONTAINER="libengju-collabora"
SAVE_COLLABORA_IMAGE="${SAVE_COLLABORA_IMAGE:-0}"

SCRIPT_FILES=(
  "/home/libengju/collabora_watch.sh"
  "/home/libengju/deploy_nc_collabora_office.sh"
  "/home/libengju/docker-compose.yml"
  "/home/libengju/install_collabora_fonts.sh"
  "/home/libengju/nextcloud_diag.sh"
  "/home/libengju/set_nextcloud.sh"
)

STAMP="$(date +%F_%H%M%S)"
SNAPSHOT_DIR="${BACKUP_ROOT}/${STAMP}"
LATEST_LINK="${BACKUP_ROOT}/latest"

log() { printf '[cloudbak] %s\n' "$*"; }
warn() { printf '[cloudbak][WARN] %s\n' "$*" >&2; }
fail() { printf '[cloudbak][ERROR] %s\n' "$*" >&2; exit 1; }

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "Missing command: $1"
}

backup_collabora_container() {
  local collab_dir="$SNAPSHOT_DIR/docker/collabora"
  local image_ref=""

  mkdir -p "$collab_dir"

  log "Backing up Collabora container metadata"

  if ! docker ps -a --format '{{.Names}}' | grep -qx "$COLLABORA_CONTAINER"; then
    warn "Collabora container not found, skipped: $COLLABORA_CONTAINER"
    return 0
  fi

  image_ref="$(docker inspect -f '{{.Config.Image}}' "$COLLABORA_CONTAINER" 2>/dev/null || true)"

  docker inspect "$COLLABORA_CONTAINER" > "$collab_dir/${COLLABORA_CONTAINER}.inspect.json" 2>/dev/null || true
  docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$COLLABORA_CONTAINER" > "$collab_dir/${COLLABORA_CONTAINER}.env.txt" 2>/dev/null || true
  docker logs --tail 1000 "$COLLABORA_CONTAINER" > "$collab_dir/${COLLABORA_CONTAINER}.last1000.log" 2>&1 || true

  docker exec "$COLLABORA_CONTAINER" cat /etc/coolwsd/coolwsd.xml > "$collab_dir/coolwsd.xml" 2>/dev/null || warn "Could not export /etc/coolwsd/coolwsd.xml"

  printf '%s\n' "$image_ref" > "$collab_dir/image_ref.txt"
  if [[ -n "$image_ref" ]]; then
    docker image inspect "$image_ref" > "$collab_dir/image.inspect.json" 2>/dev/null || true
  fi

  if [[ -f /etc/nginx/sites-enabled/myoffice ]]; then
    cp -a /etc/nginx/sites-enabled/myoffice "$collab_dir/nginx-myoffice.conf"
  else
    warn "Missing nginx myoffice config: /etc/nginx/sites-enabled/myoffice"
  fi

  cat > "$collab_dir/README.txt" <<README_EOF
Collabora backup contents
=========================

Container name:
$COLLABORA_CONTAINER

Image reference:
$image_ref

Files:
- ${COLLABORA_CONTAINER}.inspect.json : docker inspect output
- ${COLLABORA_CONTAINER}.env.txt      : container environment variables
- ${COLLABORA_CONTAINER}.last1000.log : recent container logs
- coolwsd.xml                         : /etc/coolwsd/coolwsd.xml from inside container
- image_ref.txt                       : current image reference
- image.inspect.json                  : docker image inspect output
- nginx-myoffice.conf                 : /etc/nginx/sites-enabled/myoffice

Optional:
- collabora-image.tar.gz              : docker save output when SAVE_COLLABORA_IMAGE=1

Restore hints:
1. Check nginx-myoffice.conf and env.txt first.
2. If collabora-image.tar.gz exists, restore with:
   docker load < collabora-image.tar.gz
3. Recreate the container using image_ref.txt and env.txt as reference.
README_EOF

  if [[ "$SAVE_COLLABORA_IMAGE" == "1" && -n "$image_ref" ]]; then
    log "Saving Collabora image archive (SAVE_COLLABORA_IMAGE=1)"
    docker save "$image_ref" | gzip -1 > "$collab_dir/collabora-image.tar.gz"
  fi

  log "Collabora backup done"
}

for cmd in rsync tar mysqldump docker findmnt df du readlink gzip; do
  need_cmd "$cmd"
done

[[ -d "${NC_WEB_ROOT}" ]] || fail "Nextcloud web root not found: ${NC_WEB_ROOT}"
[[ -f "${NC_CONFIG}" ]] || fail "Nextcloud config not found: ${NC_CONFIG}"
[[ -d "${NC_DATA_DIR}" ]] || fail "Nextcloud data directory not found: ${NC_DATA_DIR}"

mkdir -p "${SNAPSHOT_DIR}"/{configs,db,docker,scripts,meta,data}

{
  echo "cloudbak_snapshot=${STAMP}"
  echo "backup_root=${BACKUP_ROOT}"
  echo "nextcloud_web_root=${NC_WEB_ROOT}"
  echo "nextcloud_config=${NC_CONFIG}"
  echo "nextcloud_data_dir=${NC_DATA_DIR}"
  echo "database_name=${DB_NAME}"
  echo "database_user=${DB_USER}"
  echo "collabora_container=${COLLABORA_CONTAINER}"
  echo "save_collabora_image=${SAVE_COLLABORA_IMAGE}"
  echo "hostname=$(hostname)"
  echo "kernel=$(uname -r)"
  echo "date=$(date --iso-8601=seconds)"
  echo "mount_sdb1=$(findmnt -no TARGET,SOURCE,FSTYPE /dev/sdb1 2>/dev/null || true)"
  echo "disk_usage_target=$(df -h /dev/sdb1 2>/dev/null | tail -n1 || true)"
} > "${SNAPSHOT_DIR}/meta/SUMMARY.txt"

log "Backing up nginx configuration"
cp -a /etc/nginx/sites-available "${SNAPSHOT_DIR}/configs/"
cp -a /etc/nginx/sites-enabled "${SNAPSHOT_DIR}/configs/"

log "Backing up Nextcloud config"
mkdir -p "${SNAPSHOT_DIR}/configs/nextcloud"
cp -a "${NC_CONFIG}" "${SNAPSHOT_DIR}/configs/nextcloud/config.php"

log "Backing up useful logs"
mkdir -p "${SNAPSHOT_DIR}/meta/logs"
for f in \
  "${NC_LOG_ROOT}/nextcloud.log" \
  "${NC_LOG_ROOT}/ncdata/nextcloud.log" \
  "${NC_LOG_ROOT}/server-data/nextcloud.log"
do
  [[ -f "$f" ]] && cp -a "$f" "${SNAPSHOT_DIR}/meta/logs/"
done

log "Backing up selected operator scripts"
for f in "${SCRIPT_FILES[@]}"; do
  if [[ -f "$f" ]]; then
    cp -a "$f" "${SNAPSHOT_DIR}/scripts/"
  else
    warn "Missing script, skipped: $f"
  fi
done

log "Capturing docker metadata"
docker ps -a > "${SNAPSHOT_DIR}/docker/docker-ps-a.txt" || true
docker images > "${SNAPSHOT_DIR}/docker/docker-images.txt" || true
docker inspect "${COLLABORA_CONTAINER}" > "${SNAPSHOT_DIR}/docker/${COLLABORA_CONTAINER}.inspect.json" 2>/dev/null || warn "Could not inspect ${COLLABORA_CONTAINER}"
docker logs --tail 200 "${COLLABORA_CONTAINER}" > "${SNAPSHOT_DIR}/docker/${COLLABORA_CONTAINER}.last200.log" 2>/dev/null || warn "Could not read ${COLLABORA_CONTAINER} logs"

backup_collabora_container

log "Backing up database"
if sudo mysql -e "USE ${DB_NAME};" >/dev/null 2>&1; then
  mysqldump --single-transaction --quick --routines --triggers "${DB_NAME}" | gzip -c > "${SNAPSHOT_DIR}/db/${DB_NAME}.sql.gz"
else
  fail "MariaDB access failed. Cannot dump database ${DB_NAME}."
fi

log "Backing up data snapshot with incremental hardlinks when possible"
LINK_DEST=""
if [[ -L "${LATEST_LINK}" ]]; then
  PREV_REAL="$(readlink -f "${LATEST_LINK}")"
  if [[ -d "${PREV_REAL}/data/ncdata" ]]; then
    LINK_DEST="--link-dest=${PREV_REAL}/data/ncdata"
  fi
fi

if [[ -n "${LINK_DEST}" ]]; then
  rsync -aHAX --numeric-ids ${LINK_DEST} "${NC_DATA_DIR}/" "${SNAPSHOT_DIR}/data/ncdata/"
else
  rsync -aHAX --numeric-ids "${NC_DATA_DIR}/" "${SNAPSHOT_DIR}/data/ncdata/"
fi

log "Recording size information"
{
  echo
  echo "---- size report ----"
  du -sh "${SNAPSHOT_DIR}/configs" 2>/dev/null || true
  du -sh "${SNAPSHOT_DIR}/db" 2>/dev/null || true
  du -sh "${SNAPSHOT_DIR}/docker" 2>/dev/null || true
  du -sh "${SNAPSHOT_DIR}/scripts" 2>/dev/null || true
  du -sh "${SNAPSHOT_DIR}/data/ncdata" 2>/dev/null || true
  du -sh "${SNAPSHOT_DIR}" 2>/dev/null || true
} >> "${SNAPSHOT_DIR}/meta/SUMMARY.txt"

log "Refreshing latest symlink"
ln -sfn "${SNAPSHOT_DIR}" "${LATEST_LINK}"

log "Backup completed"
echo
echo "Snapshot created:"
echo "  ${SNAPSHOT_DIR}"
echo
echo "Latest link:"
echo "  ${LATEST_LINK}"
echo
echo "Important note:"
echo "  This protects you from bad updates and accidental changes."
echo "  It is NOT a full disaster backup against failure of /dev/sdb1,"
echo "  because both live data and cloudbak live on the same 1TB disk."
echo "  Keep one more copy on another disk or another machine if possible."
